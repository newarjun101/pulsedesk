generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  WORKSPACE_OWNER
  ADMIN
  MANAGER
  MODERATOR
  SUPPORT_AGENT
  CONTENT_CREATOR
  ANALYST
  VIEWER
}

enum MemberStatus {
  ACTIVE
  SUSPENDED
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  TIKTOK
}

enum ConnectionMethod {
  OAUTH
  MANUAL
}

enum ConnectionStatus {
  CONNECTED
  EXPIRED
  REVOKED
  ERROR
  DISCONNECTED
}

enum CapabilityStatus {
  SUPPORTED
  UNSUPPORTED
  REQUIRES_PERMISSION
  REQUIRES_APPROVAL
  ACCOUNT_INELIGIBLE
  TEMPORARILY_UNAVAILABLE
}

enum PostStatus {
  DRAFT
  PENDING
  SCHEDULED
  PROCESSING
  PUBLISHED
  FAILED
  CANCELLED
  PARTIALLY_PUBLISHED
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String    @map("password_hash")
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  avatarUrl       String?   @map("avatar_url")
  isEmailVerified Boolean   @default(false) @map("is_email_verified")
  isSuspended     Boolean   @default(false) @map("is_suspended")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  sessions            Session[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  ownedWorkspaces     Workspace[]          @relation("WorkspaceOwner")
  memberships         WorkspaceMember[]
  sentInvitations     Invitation[]         @relation("InvitedBy")
  auditLogs           AuditLog[]           @relation("AuditActor")

  @@map("users")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("sessions")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  sessionId         String    @map("session_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Workspace {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  timezone  String    @default("UTC")
  logoUrl   String?   @map("logo_url")
  ownerId   String    @map("owner_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  owner       User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members     WorkspaceMember[]
  invitations Invitation[]
  roles          Role[]
  departments    Department[]
  socialAccounts SocialAccount[]
  mediaAssets    MediaAsset[]
  socialPosts    SocialPost[]
  auditLogs      AuditLog[]

  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(VIEWER)
  status      MemberStatus  @default(ACTIVE)
  joinedAt    DateTime      @default(now()) @map("joined_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRoles MemberRole[]
  departments DepartmentMember[]

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
  @@map("workspace_members")
}

model Invitation {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  email       String
  role        WorkspaceRole @default(VIEWER)
  tokenHash   String        @unique @map("token_hash")
  invitedById String        @map("invited_by_id") @db.Uuid
  expiresAt   DateTime      @map("expires_at")
  acceptedAt  DateTime?     @map("accepted_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
  @@map("invitations")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String?  @map("workspace_id") @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json?
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?      @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  slug        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  members     MemberRole[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  group       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@map("role_permissions")
}

model MemberRole {
  id        String   @id @default(uuid()) @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  member WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role   Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([memberId, roleId])
  @@index([memberId])
  @@map("member_roles")
}

model Department {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   DepartmentMember[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("departments")
}

model DepartmentMember {
  id           String   @id @default(uuid()) @db.Uuid
  departmentId String   @map("department_id") @db.Uuid
  memberId     String   @map("member_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  department Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  member     WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([departmentId, memberId])
  @@index([memberId])
  @@map("department_members")
}

model SocialAccount {
  id                String           @id @default(uuid()) @db.Uuid
  workspaceId       String           @map("workspace_id") @db.Uuid
  platform          SocialPlatform
  platformAccountId String           @map("platform_account_id")
  accountName       String           @map("account_name")
  username          String?
  profilePictureUrl String?          @map("profile_picture_url")
  connectionMethod  ConnectionMethod @map("connection_method")
  connectionStatus  ConnectionStatus @default(CONNECTED) @map("connection_status")
  lastValidatedAt   DateTime?        @map("last_validated_at")
  lastSyncedAt      DateTime?        @map("last_synced_at")
  tokenExpiresAt    DateTime?        @map("token_expires_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  workspace    Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  credential   SocialAccountCredential?
  permissions  SocialAccountPermission[]
  capabilities SocialAccountCapability[]
  postTargets  PostTarget[]

  @@unique([workspaceId, platform, platformAccountId])
  @@index([workspaceId])
  @@map("social_accounts")
}

model SocialAccountCredential {
  id                    String    @id @default(uuid()) @db.Uuid
  socialAccountId       String    @unique @map("social_account_id") @db.Uuid
  encryptedAccessToken  String    @map("encrypted_access_token")
  encryptedRefreshToken String?   @map("encrypted_refresh_token")
  iv                    String
  authTag               String    @map("auth_tag")
  keyVersion            String    @default("v1") @map("key_version")
  expiresAt             DateTime? @map("expires_at")
  lastValidatedAt       DateTime? @map("last_validated_at")
  validationError       String?   @map("validation_error")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@map("social_account_credentials")
}

model SocialAccountPermission {
  id              String   @id @default(uuid()) @db.Uuid
  socialAccountId String   @map("social_account_id") @db.Uuid
  scope           String
  granted         Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, scope])
  @@index([socialAccountId])
  @@map("social_account_permissions")
}

model SocialAccountCapability {
  id              String           @id @default(uuid()) @db.Uuid
  socialAccountId String           @map("social_account_id") @db.Uuid
  capability      String
  status          CapabilityStatus
  reason          String?
  updatedAt       DateTime         @updatedAt @map("updated_at")

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, capability])
  @@index([socialAccountId])
  @@map("social_account_capabilities")
}

model WebhookEvent {
  id              String         @id @default(uuid()) @db.Uuid
  platform        SocialPlatform
  externalEventId String         @map("external_event_id")
  eventType       String         @map("event_type")
  payload         Json
  signatureValid  Boolean        @default(false) @map("signature_valid")
  processedAt     DateTime?      @map("processed_at")
  error           String?
  createdAt       DateTime       @default(now()) @map("created_at")

  @@unique([platform, externalEventId])
  @@index([platform, createdAt])
  @@map("webhook_events")
}

model MediaAsset {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  fileName     String    @map("file_name")
  mimeType     String    @map("mime_type")
  sizeBytes    Int       @map("size_bytes")
  mediaType    MediaType @map("media_type")
  s3Key        String    @map("s3_key")
  url          String
  folder       String?
  width        Int?
  height       Int?
  durationSec  Int?      @map("duration_sec")
  uploadStatus String    @default("READY") @map("upload_status")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  postMedia PostMedia[]

  @@index([workspaceId])
  @@map("media_assets")
}

model SocialPost {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String     @map("workspace_id") @db.Uuid
  authorId    String     @map("author_id") @db.Uuid
  content     String
  status      PostStatus @default(DRAFT)
  scheduledAt DateTime?  @map("scheduled_at")
  publishedAt DateTime?  @map("published_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  targets   PostTarget[]
  media     PostMedia[]

  @@index([workspaceId, status])
  @@index([scheduledAt])
  @@map("social_posts")
}

model PostTarget {
  id              String         @id @default(uuid()) @db.Uuid
  postId          String         @map("post_id") @db.Uuid
  socialAccountId String         @map("social_account_id") @db.Uuid
  platform        SocialPlatform
  caption         String?
  externalPostId  String?        @map("external_post_id")
  status          PostStatus     @default(PENDING)
  error           String?
  publishedAt     DateTime?      @map("published_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  post          SocialPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([socialAccountId])
  @@map("post_targets")
}

model PostMedia {
  id           String @id @default(uuid()) @db.Uuid
  postId       String @map("post_id") @db.Uuid
  mediaAssetId String @map("media_asset_id") @db.Uuid
  sortOrder    Int    @default(0) @map("sort_order")

  post       SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([postId, mediaAssetId])
  @@map("post_media")
}

model PublishingLog {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  postId      String   @map("post_id") @db.Uuid
  targetId    String?  @map("target_id") @db.Uuid
  status      String
  message     String
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([workspaceId, postId])
  @@map("publishing_logs")
}

enum ConversationStatus {
  OPEN
  PENDING
  WAITING
  RESOLVED
  ARCHIVED
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  STICKER
  SYSTEM
  INTERNAL_NOTE
}

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  WAITING_FOR_INTERNAL_TEAM
  RESOLVED
  CLOSED
  REOPENED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model SocialContact {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  displayName String   @map("display_name")
  email       String?
  isVip       Boolean  @default(false) @map("is_vip")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  identities    CustomerIdentity[]
  conversations Conversation[]
  tickets       Ticket[]

  @@index([workspaceId])
  @@map("social_contacts")
}

model CustomerIdentity {
  id              String         @id @default(uuid()) @db.Uuid
  contactId       String         @map("contact_id") @db.Uuid
  platform        SocialPlatform
  externalUserId  String         @map("external_user_id")
  username        String?
  profilePicUrl   String?        @map("profile_pic_url")
  createdAt       DateTime       @default(now()) @map("created_at")

  contact SocialContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([platform, externalUserId])
  @@index([contactId])
  @@map("customer_identities")
}

model Conversation {
  id              String             @id @default(uuid()) @db.Uuid
  workspaceId     String             @map("workspace_id") @db.Uuid
  socialAccountId String             @map("social_account_id") @db.Uuid
  contactId       String             @map("contact_id") @db.Uuid
  platform        SocialPlatform
  externalConvId  String?            @map("external_conv_id")
  status          ConversationStatus @default(OPEN)
  assignedToId    String?            @map("assigned_to_id") @db.Uuid
  lastMessageAt   DateTime           @default(now()) @map("last_message_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  contact  SocialContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages Message[]
  tickets  Ticket[]

  @@index([workspaceId, status])
  @@map("conversations")
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  senderType     String      @map("sender_type")
  senderId       String?     @map("sender_id")
  type           MessageType @default(TEXT)
  body           String
  externalMsgId  String?     @map("external_msg_id")
  deliveryStatus String      @default("SENT") @map("delivery_status")
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Comment {
  id                String         @id @default(uuid()) @db.Uuid
  workspaceId       String         @map("workspace_id") @db.Uuid
  socialAccountId   String         @map("social_account_id") @db.Uuid
  platform          SocialPlatform
  externalCommentId String         @map("external_comment_id")
  externalPostId    String         @map("external_post_id")
  authorName        String         @map("author_name")
  body              String
  isHidden          Boolean        @default(false) @map("is_hidden")
  isHandled         Boolean        @default(false) @map("is_handled")
  createdAt         DateTime       @default(now()) @map("created_at")

  @@unique([platform, externalCommentId])
  @@index([workspaceId])
  @@map("comments")
}

model ModerationAction {
  id             String         @id @default(uuid()) @db.Uuid
  workspaceId    String         @map("workspace_id") @db.Uuid
  actorId        String         @map("actor_id") @db.Uuid
  platform       SocialPlatform
  actionType     String         @map("action_type")
  targetUserId   String         @map("target_user_id")
  reason         String?
  externalResult String?        @map("external_result")
  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([workspaceId])
  @@map("moderation_actions")
}

model Ticket {
  id             String         @id @default(uuid()) @db.Uuid
  workspaceId    String         @map("workspace_id") @db.Uuid
  contactId      String?        @map("contact_id") @db.Uuid
  conversationId String?        @map("conversation_id") @db.Uuid
  subject        String
  description    String
  priority       TicketPriority @default(NORMAL)
  status         TicketStatus   @default(OPEN)
  assignedToId   String?        @map("assigned_to_id") @db.Uuid
  slaDeadline    DateTime?      @map("sla_deadline")
  resolvedAt     DateTime?      @map("resolved_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  contact      SocialContact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversation Conversation?   @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  messages     TicketMessage[]

  @@index([workspaceId, status])
  @@map("tickets")
}

model TicketMessage {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  isPublic  Boolean  @default(true) @map("is_public")
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_messages")
}

model AutomationRule {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  trigger     String
  conditions  Json
  actions     Json
  isEnabled   Boolean  @default(true) @map("is_enabled")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("automation_rules")
}

model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  type        String
  title       String
  body        String
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([workspaceId, userId])
  @@map("notifications")
}
